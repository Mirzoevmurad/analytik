# Скопируйте этот файл в .env и заполните
ANALYTIK_BOT_TOKEN=put-your-bot-token-here
GROQ_API_KEY=put-your-groq-key-here

# Через запятую user_id тех, кому разрешено пользоваться ботом
ALLOWED_USER_IDS=123456789

# Модели Groq (https://console.groq.com/docs/models)
STT_MODEL=whisper-large-v3-turbo
LLM_MODEL=llama-3.3-70b-versatile

# Язык распознавания по умолчанию: ru, en, auto
DEFAULT_LANG=auto

# Сколько последних сообщений хранить в контексте (чем больше — тем дороже)
MAX_CONTEXT_MESSAGES=20

# Лимит размера аудио (Groq API принимает до 25 МБ)
MAX_AUDIO_MB=25

# Голосовые ответы по умолчанию (true/false)
VOICE_RESPONSES=false
